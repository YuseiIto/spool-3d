# Response headers for Cloudflare Workers static assets.
#
# Every rule whose pattern matches contributes its headers, and a header given twice is returned
# twice rather than overridden. That matters here more than anywhere: a response carrying two
# Content-Security-Policy headers is subject to both policies at once, and what is allowed is
# their intersection — so a permissive rule cannot loosen a strict one, it can only be ignored.
# Each path below therefore receives exactly one policy, and the strict one is scoped to the
# document rather than written as a catch-all.
#
# Note there is deliberately no COOP/COEP pair here: manifold-3d is built single-threaded, so it
# needs no SharedArrayBuffer and no cross-origin isolation. Adding those headers would only break
# embedding for no gain.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The policy for the page. A document's policy already governs every script, style and font it
# goes on to load, so the assets themselves need none of their own — and giving them one would
# only add a second policy to the worker below.
/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; worker-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'

/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; worker-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'

# The worker runs the CAD kernel, whose Emscripten embind glue builds its invoker functions with
# `new Function`. That needs 'unsafe-eval', so the worker gets a policy of its own rather than
# every script on the page being granted it. A worker script served with its own
# Content-Security-Policy uses that instead of inheriting the document's.
/workers/*
  Content-Security-Policy: script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self'; object-src 'none'
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed by Vite, so these can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
